[Unit]
Description=Restore the previous Keel if an update did not finish
DefaultDependencies=no
Before=keel.service
ConditionPathExists=/var/lib/keel/updates/pending

[Service]
Type=oneshot
ExecStart=/usr/lib/keel/rollback-update
TimeoutStartSec=120

[Install]
# Boot only. WantedBy=keel.service made every restart run this restore, which
# put the previous program back before the new one could answer.
WantedBy=multi-user.target
